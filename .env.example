# Sigil configuration. Copy to `.env` and fill in. All keys are read by
# sigil.config.Settings (one source of truth). Only the values marked REQUIRED
# must be set; everything else has a sensible default.

# --- LLM provider (set at least one) ---------------------------------------
# If OPENAI_API_KEY is set, the OpenAI models are used; otherwise Anthropic.
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# LLM model + token tuning (optional). These drive the first-pass JUDGE.
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=2000
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000

# Report generator (second pass) - runs ONLY on CLEAR_VIOLATION posts, so a
# premium model is affordable here. Prefers Anthropic (Opus) by default; the
# token cap bounds spend per flagged row.
REPORT_PREFER_ANTHROPIC=true
REPORT_CLAUDE_MODEL=claude-opus-4-5-20251101
REPORT_OPENAI_MODEL=gpt-4o
REPORT_MAX_TOKENS=6000

# Multimodal limits (optional)
PREFERRED_MAX_IMAGES=4
MAX_IMAGE_SIZE_BYTES=5242880
MAX_TRANSCRIPT_LENGTH_CHARS=5000
WHISPER_MAX_FILE_SIZE_BYTES=25165824

# Outbound HTTP for image/policy fetching (optional)
SCRAPER_TIMEOUT_SECONDS=10
# SCRAPER_USER_AGENT=

# Override the bundled policy directory (optional; defaults to packaged policies)
# POLICIES_DIR=/etc/sigil/policies
# DEBUG_DIR=debug

# --- Apify + Supabase (REQUIRED) -------------------------------------------
APIFY_TOKEN=apify_api_your-token-here
# SQLAlchemy asyncpg URL for the Supabase session pooler:
#   postgresql+asyncpg://postgres.<ref>:<password>@<host>:5432/postgres
SUPABASE_DB_URL=postgresql+asyncpg://postgres.<ref>:<password>@<host>:5432/postgres

# --- Orchestration tuning (optional) ---------------------------------------
MAX_CONCURRENT_RUNS=4
DAILY_BUDGET_USD=50.0
RUNNER_INTERVAL_SECS=900
COLLECTOR_INTERVAL_SECS=60
RESULTS_LIMIT_PER_RUN=1000
MAX_RUN_RETRIES=3
ACTOR_MAX_RESULTS_PER_RUN=5000
EST_COST_PER_RUN_USD=1.0

# --- Validation loop (runs inside the scheduler) ---------------------------
# Set VALIDATION_ENABLED=false to run scraping only and validate separately
# via `sigil validate`. The loop drains the pending queue each interval.
VALIDATION_ENABLED=true
VALIDATION_INTERVAL_SECS=120
VALIDATION_BATCH_LIMIT=100
VALIDATION_CONCURRENCY=5

LOG_LEVEL=INFO
CAMPAIGNS_FILE=campaigns.yaml

# --- Live status HTTP server (inside the scheduler process) ----------------
STATUS_HOST=0.0.0.0
STATUS_PORT=8002

# --- Per-platform Apify actor overrides (optional) -------------------------
TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
INSTAGRAM_ACTOR_ID=apify/instagram-scraper
FACEBOOK_ACTOR_ID=apify/facebook-posts-scraper
TWITTER_ACTOR_ID=apidojo/twitter-scraper-lite
LINKEDIN_ACTOR_ID=buIWk2uOUzTmcLsuB
REDDIT_ACTOR_ID=xBj1aoFdikikCx40j
